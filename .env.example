# Optional. Everything works keyless without it.
#
# Set ADMIN_KEY to gate the admin endpoints (list/delete agents, read/change
# settings): clients then pass `Authorization: Bearer <ADMIN_KEY>` (or
# x-admin-key: <ADMIN_KEY>). With it unset, those endpoints stay open —
# fine for a personal deployment, not for a public one.
ADMIN_KEY=

# Agent API keys expire this many days after signup (default 90, 0 = expire
# immediately). Expired keys are rejected with 401 and pruned automatically.
AGENT_KEY_TTL_DAYS=90

# Hard cap on the in-memory agent registry (default 10000).
MAX_AGENTS=10000

# Rate limits (requests per window, per IP). Defaults shown.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300          # global bucket, all routes
AUTH_RATE_WINDOW_MS=600000
AUTH_RATE_MAX=30            # stricter bucket for /agents/signup + /agents/signin
ADMIN_RATE_WINDOW_MS=60000
ADMIN_RATE_MAX=120          # admin endpoints

# Max JSON request body size (default 100kb).
JSON_BODY_LIMIT=100kb

# Outbound recon fetch timeout in ms (default 10000).
RECON_TIMEOUT_MS=10000
